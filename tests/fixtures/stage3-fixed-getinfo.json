[
  {
    "id": "native-default",
    "values": {},
    "getInfo": {
      "id": "kubohiroyatextlines",
      "name": "Text Lines",
      "docsURI": "https://kubohiroya.github.io/turbowarp-text-lines/",
      "blockIconURI": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%3E%3Cg%20fill%3D%22%234C97FF%22%3E%3Ccircle%20cx%3D%2211%22%20cy%3D%2216%22%20r%3D%222.6%22%2F%3E%3Ccircle%20cx%3D%2211%22%20cy%3D%2224%22%20r%3D%222.6%22%2F%3E%3Ccircle%20cx%3D%2211%22%20cy%3D%2232%22%20r%3D%222.6%22%2F%3E%3C%2Fg%3E%3Cpath%20d%3D%22M19%2016h20M19%2024h20M19%2032h13%22%20fill%3D%22none%22%20stroke%3D%22%2359C059%22%20stroke-width%3D%223%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E",
      "color1": "#5B80A5",
      "blocks": [
        {
          "opcode": "lineCount",
          "blockType": "reporter",
          "text": "number of lines in [TEXT]",
          "arguments": {
            "TEXT": {
              "type": "string",
              "defaultValue": "first line\nsecond line"
            }
          }
        },
        {
          "opcode": "lineAt",
          "blockType": "reporter",
          "text": "line [LINE] of [TEXT]",
          "arguments": {
            "TEXT": {
              "type": "string",
              "defaultValue": "first line\nsecond line"
            },
            "LINE": {
              "type": "number",
              "defaultValue": 1
            }
          }
        },
        {
          "opcode": "linesJson",
          "blockType": "reporter",
          "text": "lines of [TEXT] as JSON",
          "arguments": {
            "TEXT": {
              "type": "string",
              "defaultValue": "first line\nsecond line"
            }
          }
        },
        {
          "opcode": "writeLinesToList",
          "blockType": "command",
          "text": "put lines of [TEXT] into list [LIST]",
          "arguments": {
            "TEXT": {
              "type": "string",
              "defaultValue": "first line\nsecond line"
            },
            "LIST": {
              "type": "string",
              "menu": "LIST_MENU"
            }
          }
        }
      ],
      "menus": {
        "LIST_MENU": {
          "acceptReporters": true,
          "items": "getLists"
        }
      }
    }
  }
]
