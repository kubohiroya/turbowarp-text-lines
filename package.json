{
  "name": "@kubohiroya/turbowarp-text-lines",
  "version": "0.3.0",
  "description": "Use multiline text in TurboWarp projects with line counting, lookup, and list-writing blocks.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-text-lines#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-text-lines.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-text-lines/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "text",
    "lines",
    "list"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "README.md",
    "LICENSE",
    "schemas/",
    "docs/fixed-input-editors.ja.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "check:dist": "pnpm run build && git diff --exit-code -- dist",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check"
  },
  "devDependencies": {
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.8.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.3.4"
  },
  "gitHead": "f43722feb24d4d2169953ee44c640a3dc44532fd",
  "x-turbowarp-source": {
    "revision": "f43722feb24d4d2169953ee44c640a3dc44532fd",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
